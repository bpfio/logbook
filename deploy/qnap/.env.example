# ==============================================================================
# Logbook QNAP 生产环境密钥模板
# 用法: cp .env.example .env && 按实际情况填写真实值 (.env 已被 .gitignore 忽略)
# compose.yaml 通过 ${VAR} 引用本文件中的变量 (compose 自动加载同目录 .env)
# ==============================================================================

# 星火大模型平台 API Key (形如 "key:secret")
EMBEDDING_API_KEY=your-xinghuo-api-key-here

# PostgreSQL 数据库口令 (DATABASE_URL 与 POSTGRES_PASSWORD 共用)
LOGBOOK_DB_PASSWORD=change-me-strong-password

# SSH 授权公钥列表（每行一个；生产环境按部署文档填写）
SSH_AUTHORIZED_KEYS=

# 默认 SSH principal 对应的 Agent 身份（多 Agent 请使用独立 principal）
LOGBOOK_DEFAULT_AGENT_ID=agy
